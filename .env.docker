ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=DEBUG
APP_NAME=orderly
SECRET_KEY=local-dev-only-not-a-secret
ENV_FILE=.env.docker
#DB
DB__NAME=app
DB__USER=postgres
DB__PASSWORD=postgres
DB__PORT=5432
DB__HOST=postgres
DB__DRIVER=postgresql+psycopg
#Auth
AUTH__OTP_EXPIRE_TIME_SECONDS=300
AUTH__OTP_LENGTH=6
#Email
EMAIL__FROM_EMAIL="info@orderly.com"
# Redis
REDIS__URL=redis://redis:6379/0
REDIS__MAX_CONNECTIONS=20
REDIS__SOCKET_CONNECT_TIMEOUT=2
REDIS__SOCKET_TIMEOUT=2
REDIS__HEALTH_CHECK_INTERVAL=30
