[
  {
    "label": "FastAPI: Production",
    "command": "uvicorn",
    "args": [
      "fastapi_orderly.main:create_app",
      "--host",
      "0.0.0.0",
      "--port",
      "8000",
      "--factory",
    ],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "all",
  },
  {
    "label": "FastAPI: Development",
    "command": "uvicorn",
    "args": [
      "fastapi_orderly.main:create_app",
      "--host",
      "127.0.0.1",
      "--port",
      "8000",
      "--reload",
      "--factory",
    ],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "all",
  },
]
